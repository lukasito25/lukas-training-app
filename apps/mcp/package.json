{
  "name": "@liftwise/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LiftWise MCP server: the ChatGPT app / Claude connector (remote MCP over Streamable HTTP, OAuth via Supabase).",
  "scripts": {
    "dev": "node scripts/build-widget.mjs && tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "typecheck": "node scripts/build-widget.mjs && tsc --noEmit && tsc --noEmit -p widget",
    "test": "vitest run",
    "claim-legacy": "tsx scripts/claim-legacy-data.ts",
    "bundle": "node scripts/build-widget.mjs && node scripts/bundle.mjs",
    "build:widget": "node scripts/build-widget.mjs",
    "pretest": "node scripts/build-widget.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.110.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
